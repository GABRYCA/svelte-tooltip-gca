{
	"name": "svelte-tooltip-gca",
	"version": "1.0.0",
	"description": "Modern, theme-aware tooltip action for Svelte 5 with auto light/dark themes and mobile-friendly",
	"license": "MIT",
	"author": {
		"name": "AnonymousGCA",
		"email": "anonymousgca@anonymousgca.eu",
		"url": "https://anonymousgca.eu"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GABRYCA/svelte-tooltip-gca.git"
	},
	"bugs": {
		"url": "https://github.com/GABRYCA/svelte-tooltip-gca/issues"
	},
	"homepage": "https://github.com/GABRYCA/svelte-tooltip-gca#readme",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.22",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"tooltip",
		"action",
		"use:tooltip",
		"popover",
		"dark-mode",
		"ui",
		"component"
	]
}
