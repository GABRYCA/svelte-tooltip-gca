{
	"name": "svelte-tooltip-gca",
	"version": "1.1.0",
	"description": "Modern, theme-aware tooltip action for Svelte 5 with auto light/dark themes and mobile-friendly",
	"license": "MIT",
	"author": {
		"name": "AnonymousGCA",
		"email": "anonymousgca@anonymousgca.eu",
		"url": "https://anonymousgca.eu"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GABRYCA/svelte-tooltip-gca.git"
	},
	"bugs": {
		"url": "https://github.com/GABRYCA/svelte-tooltip-gca/issues"
	},
	"homepage": "https://gabryca.github.io/svelte-tooltip-gca/",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/generate-ai-docs.mjs && vite build && npm run prepack",
		"generate:ai-docs": "node scripts/generate-ai-docs.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint --pack npm",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"publint": "^0.3.25",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"tooltip",
		"action",
		"use:tooltip",
		"popover",
		"anchor-positioning",
		"dark-mode",
		"ui",
		"component"
	]
}
